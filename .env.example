# ---------------------------------------------------------------------------
# Aidstack Insights — server-side AI configuration (all optional)
#
# Copy to .env and fill in. Anything set here acts as a FALLBACK: values a user
# enters in the in-app Settings modal always take precedence. Leaving this file
# empty is fine — users then supply their own credentials in the browser.
# ---------------------------------------------------------------------------

# Which provider to use when the browser does not specify one: openai | azure
LLM_PROVIDER=openai

# --- Option A: OpenAI ------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Option B: Azure AI Foundry / Azure OpenAI ------------------------------
# Set LLM_PROVIDER=azure above, then fill these in.
#
# ENDPOINT   : the base URL of your Azure resource, no trailing path.
#              Azure portal -> your resource -> "Keys and Endpoint".
# API_KEY    : either of the two keys shown on that same page.
# DEPLOYMENT : the *deployment* name you created under "Model deployments"
#              in Azure AI Foundry. This is chosen by your organization and is
#              often NOT the same as the underlying model name.
# API_VERSION: optional; defaults to 2024-10-21.
#
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Local server options ---------------------------------------------------
# PORT=8080
# HOST=127.0.0.1
